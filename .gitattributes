# Unity: YAML en texto para que los diffs sean legibles
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.meta text eol=lf
*.cs text eol=lf
# Binarios pequeños (modelos Low Poly < 1 MB, previews) van en git normal:
# así no gastan la cuota de LFS en cada build de CI y se pueden subir desde
# la nube de Claude, donde lfs.github.com está bloqueado por la red.
*.fbx binary
*.glb binary
*.png binary
*.jpg binary
# Binarios grandes en Git LFS
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
graphify-out/graph.json merge=graphify
